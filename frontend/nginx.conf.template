server {
  listen 3000;
  listen [::]:3000;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;
  charset utf-8;
  server_tokens off;

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types application/javascript application/json image/svg+xml text/css text/plain;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  location = /index.html {
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    try_files $uri =404;
  }

  # The worker script must revalidate on every check, or an old worker can
  # pin an old shell indefinitely.
  location = /sw.js {
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    try_files $uri =404;
  }

  location ^~ /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    try_files $uri =404;
  }

  # A missing asset must remain a 404; returning HTML here produces opaque
  # module/MIME errors and can leave an old browser session unusable.
  location ~* \.(?:css|js|mjs|map|ico|png|jpe?g|gif|svg|webp|woff2?)$ {
    try_files $uri =404;
  }

  # Same-origin API: the browser only ever talks to this host, and nginx
  # strips the public /api mount before relaying to the backend's root. This
  # is what keeps the httpOnly session
  # cookie first-party — required for installed-PWA standalone mode and
  # immune to third-party-cookie phase-outs. BACKEND_ORIGIN is substituted
  # by the nginx image's envsubst entrypoint at container start.
  location __API_MOUNT_PATH__/ {
    proxy_pass ${BACKEND_ORIGIN}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Agent runs stream server-sent events; buffering would hold frames back
    # and the default 60s read timeout would sever a long run mid-stream.
    proxy_buffering off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
