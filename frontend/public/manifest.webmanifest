{
  "name": "fyn AI",
  "short_name": "fyn",
  "description": "A conversational personal finance workspace that turns natural language into structured financial truth.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#4340e0",
  "theme_color": "#fafafb",
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icons/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/pwa-256.png",
      "sizes": "256x256",
      "type": "image/png"
    },
    {
      "src": "/icons/pwa-384.png",
      "sizes": "384x384",
      "type": "image/png"
    },
    {
      "src": "/icons/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "finance",
    "productivity"
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "shortcuts": [
    {
      "name": "Add transaction",
      "short_name": "Add",
      "description": "Open the entry drawer on the Transactions page",
      "url": "/transactions?new=1",
      "icons": [
        {
          "src": "/icons/shortcut-add.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Ask fyn",
      "short_name": "Ask",
      "description": "Start a conversation about your finances",
      "url": "/",
      "icons": [
        {
          "src": "/icons/shortcut-ask.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Overview",
      "short_name": "Overview",
      "description": "Where the money went this month",
      "url": "/overview",
      "icons": [
        {
          "src": "/icons/shortcut-overview.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "screenshots": [
    {
      "src": "/screenshots/overview-narrow.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Where the month went"
    },
    {
      "src": "/screenshots/transactions-narrow.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Every entry, searchable"
    },
    {
      "src": "/screenshots/conversation-narrow.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Ask in plain language"
    },
    {
      "src": "/screenshots/overview-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Where the month went"
    },
    {
      "src": "/screenshots/transactions-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Every entry, searchable"
    },
    {
      "src": "/screenshots/conversation-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Ask in plain language"
    }
  ]
}
