# Where the API lives. The simulator shares the host's loopback; a physical
# device needs the machine's LAN address.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google sign-in. Each platform signs in against its own OAuth client, so the
# token's audience differs per platform — the server must list all of them in
# GOOGLE_CLIENT_ID / GOOGLE_IOS_CLIENT_ID / GOOGLE_ANDROID_CLIENT_ID or the
# native sign-in will fail verification. Leave these empty to hide the button.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
