DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance
OPENAI_API_KEY=
OPERATOR_MODEL=gpt-5.6-luna
RECONCILER_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small
PRIMARY_AGENT_ENABLED=true
SQL_LANE_ENABLED=true
# sql = full-schema arbitrary analytical SELECTs behind tenant RLS.
# hybrid = legacy AnalysisPlan/template grammar plus the SQL fallback.
ANALYSIS_QUERY_MODE=sql
# Quality-first reasoning for native-ledger SQL analysis. Routine Operator
# turns still use low effort.
OPERATOR_ANALYSIS_REASONING_EFFORT=high
# Filesystem-only governed operation catalog. Leave the managed directory empty
# to run only the protected built-ins, or mount the same directory on every API
# instance. Definitions are never copied into PostgreSQL.
OPERATIONS_MANAGED_DIR=managed-operations
OPERATIONS_WATCH_ENABLED=true
OPERATION_CANDIDATE_LIMIT=12
OPERATION_WATCH_DEBOUNCE_MS=500
# Old queued runs and restart-safe response enrichment drain through a fixed
# worker pool. Backlog size affects drain time, never task/model concurrency.
AGENT_RECOVERY_MAX_CONCURRENCY=4
AGENT_RECOVERY_CLAIM_TTL_SECONDS=300
AGENT_RECOVERY_MAX_POSTPROCESS_ATTEMPTS=2
AGENT_RECOVERY_MIN_INTERVAL_MS=50
AGENT_RECOVERY_IDLE_POLL_SECONDS=5
# The Operator owns ordinary conversation, authenticated reads, and terminal
# typed handoffs. Planner and Validator passes run only at explicit boundaries.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082
# Turns the coordinates a transaction carries into "Indiranagar, Karnataka".
# Off by default: it sends those coordinates to a third party. Names are cached
# per ~150m cell, so a regular haunt is looked up once, ever.
LOCATION_ENRICHMENT_ENABLED=false
GEOCODING_PROVIDER=auto
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim blocks clients that do not identify themselves. Put a contact
# address here that someone reads before enabling this against their public
# instance; it is how they reach you rather than block you.
GEOCODING_USER_AGENT=fyn-ai/0.1 (you@example.com)

# ── Authentication ───────────────────────────────────────────────────────────
# Set to "production" on a deployment. Startup then refuses every development
# convenience below — placeholder secret, code echo, console senders — instead
# of printing a warning about them.
ENVIRONMENT=development

# Peppers one-time-code hashes. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Startup refuses to run with ENVIRONMENT=production while this is the placeholder.
AUTH_SECRET=

# Cookie scope. Locally the API is on http, so Secure has to be off or the
# browser will never send the cookie back. In a deployment set it to true, and
# set the domain to the parent the app and the API share
# (SESSION_COOKIE_DOMAIN=.fynai.co for fynai.co + api.fynai.co). Leaving it
# empty is tighter still: the cookie is then host-only on the API, which is
# all that needs it, and the pair stays same-site either way.
# which keeps the pair same-site and makes SameSite=lax a working CSRF defence.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_TTL_DAYS=30

# Returns the one-time code in the API response so a fresh checkout can sign in
# without an SMS or email account. Local development only — startup refuses it
# once ENVIRONMENT is production.
OTP_DEBUG_ECHO=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_INTERVAL_SECONDS=45
OTP_MAX_SENDS_PER_HOUR=5
# A number typed without a country code is read against this.
DEFAULT_PHONE_PREFIX=+91

# SMS one-time codes (MSG91 Flow API). MSG91_OTP_VARIABLE must match the
# variable name in your DLT-registered template.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=JITRAA
MSG91_OTP_VARIABLE=OTP
# Separate DLT Flow template for a shared-plan invitation/reminder. Its
# variables are NAME, DUE_DATE and LINK.
MSG91_LENDING_TEMPLATE_ID=

# Email one-time codes (Postmark). The From address must be on a verified
# sender signature or domain.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=login@fynai.co
POSTMARK_MESSAGE_STREAM=outbound

# Public browser origin placed in invitation and reminder links. The worker
# claims notification_outbox rows and retries provider failures independently
# of the financial command that created them.
LENDING_WEB_URL=http://localhost:3000
LENDING_NOTIFICATION_WORKER_ENABLED=true
LENDING_NOTIFICATION_POLL_SECONDS=5
LENDING_NOTIFICATION_MAX_ATTEMPTS=5

# Google sign-in. Create an OAuth 2.0 Client ID of type "Web application" in
# Google Cloud Console → APIs & Services → Credentials, with authorised
# JavaScript origins http://localhost:3000 and https://fynai.co. The same
# value goes in the frontend as VITE_GOOGLE_CLIENT_ID. Leaving it empty
# hides Google sign-in and leaves phone and email codes working.
GOOGLE_CLIENT_ID=
# Private document evidence. Local is used for development/tests; production
# should use a non-public Cloudflare R2 bucket and a bucket-scoped API token.
# Keep real credentials in the ignored backend/.env file or the production
# secret environment. Personal lending stays unavailable in production until
# the provider is r2 and every required credential below is non-empty.
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_PATH=./data/document-assets
DOCUMENT_UPLOAD_MAX_BYTES=10485760
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_OBJECT_PREFIX=document-evidence
R2_PRESIGN_SECONDS=300
