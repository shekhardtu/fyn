DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance
OPENAI_API_KEY=
ROUTER_MODEL=gpt-5.6-luna
TRANSACTION_MODEL=gpt-5.6-luna
ANALYSIS_MODEL=gpt-5.6-terra
VALIDATOR_MODEL=gpt-5.6-luna
RECONCILIATION_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small
PRIMARY_AGENT_ENABLED=true
CORS_ORIGINS=http://localhost:3000
LOCATION_ENRICHMENT_ENABLED=false

# ── Authentication ───────────────────────────────────────────────────────────
# Set to "production" on a deployment. Startup then refuses every development
# convenience below — placeholder secret, code echo, console senders — instead
# of printing a warning about them.
ENVIRONMENT=development

# Peppers one-time-code hashes. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Startup refuses to run with ENVIRONMENT=production while this is the placeholder.
AUTH_SECRET=

# Cookie scope. Locally the API is on http, so Secure has to be off or the
# browser will never send the cookie back. In a deployment set it to true, and
# set the domain to the parent the app and the API share
# (SESSION_COOKIE_DOMAIN=.fynai.com for app.fynai.com + api.fynai.com),
# which keeps the pair same-site and makes SameSite=lax a working CSRF defence.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_TTL_DAYS=30

# Returns the one-time code in the API response so a fresh checkout can sign in
# without an SMS or email account. Local development only — startup refuses it
# once ENVIRONMENT is production.
OTP_DEBUG_ECHO=true
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_INTERVAL_SECONDS=45
OTP_MAX_SENDS_PER_HOUR=5
# A number typed without a country code is read against this.
DEFAULT_PHONE_PREFIX=+91

# SMS one-time codes (MSG91 Flow API). MSG91_OTP_VARIABLE must match the
# variable name in your DLT-registered template.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=JITRAA
MSG91_OTP_VARIABLE=otp

# Email one-time codes (Postmark). The From address must be on a verified
# sender signature or domain.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=login@fynai.com
POSTMARK_MESSAGE_STREAM=outbound

# Google sign-in. Create an OAuth 2.0 Client ID of type "Web application" in
# Google Cloud Console → APIs & Services → Credentials, with authorised
# JavaScript origins http://localhost:3000 and https://app.fynai.com. The same
# value goes in the frontend as NEXT_PUBLIC_GOOGLE_CLIENT_ID. Leaving it empty
# hides Google sign-in and leaves phone and email codes working.
GOOGLE_CLIENT_ID=
