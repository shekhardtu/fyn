DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance
NEXT_PUBLIC_API_URL=http://localhost:8000
OPENAI_API_KEY=
ROUTER_MODEL=gpt-5.6-luna
TRANSACTION_MODEL=gpt-5.6-luna
ANALYSIS_MODEL=gpt-5.6-terra
VALIDATOR_MODEL=gpt-5.6-luna
RECONCILIATION_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small
PRIMARY_AGENT_ENABLED=true
LOCATION_ENRICHMENT_ENABLED=false

# Authentication. See backend/.env.example for the full set and what each one
# refuses to start without.
ENVIRONMENT=development
AUTH_SECRET=
SESSION_COOKIE_SECURE=false
OTP_DEBUG_ECHO=true
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
# The browser needs the Google client id at build time; the server needs the
# same value to verify what the browser sends back.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
