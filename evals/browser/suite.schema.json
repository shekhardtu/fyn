{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fyn.browser-eval-suite.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suiteVersion",
    "name",
    "description",
    "defaults",
    "fixture",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "fyn.browser-eval-suite.v1"
    },
    "suiteVersion": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseUrl",
        "timezone",
        "state",
        "passThreshold",
        "requireAllCritical",
        "repetitions"
      ],
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "const": "fresh_conversation"
        },
        "passThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "requireAllCritical": {
          "type": "boolean"
        },
        "repetitions": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "account",
        "seedCommand",
        "guidance",
        "oracle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identifierType",
            "identifier",
            "dedicated"
          ],
          "properties": {
            "identifierType": {
              "const": "phone"
            },
            "identifier": {
              "const": "+919000000098"
            },
            "dedicated": {
              "const": true
            }
          }
        },
        "seedCommand": {
          "type": "string",
          "minLength": 1
        },
        "guidance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "oracle": {
          "$ref": "#/$defs/oracle"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "minorMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "currentExpenseTotalMinor",
        "previousExpenseTotalMinor",
        "twoMonthsAgoExpenseTotalMinor",
        "currentIncomeTotalMinor",
        "previousIncomeTotalMinor",
        "twoMonthsAgoIncomeTotalMinor",
        "currentNetMinor",
        "previousNetMinor",
        "twoMonthsAgoNetMinor",
        "categoryTotalsMinor",
        "foodSubcategoryTotalsMinor",
        "merchantAmountsMinor",
        "topExpenseMerchants",
        "budgetSheetTotalsMinor",
        "vendorCategoryTotalsMinor",
        "vendorTotalsMinor",
        "topTransportExcludingFlights",
        "concentratedCategories",
        "refinementChain"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "currentExpenseTotalMinor": {
          "type": "integer"
        },
        "previousExpenseTotalMinor": {
          "type": "integer"
        },
        "twoMonthsAgoExpenseTotalMinor": {
          "type": "integer"
        },
        "currentIncomeTotalMinor": {
          "type": "integer"
        },
        "previousIncomeTotalMinor": {
          "type": "integer"
        },
        "twoMonthsAgoIncomeTotalMinor": {
          "type": "integer"
        },
        "currentNetMinor": {
          "type": "integer"
        },
        "previousNetMinor": {
          "type": "integer"
        },
        "twoMonthsAgoNetMinor": {
          "type": "integer"
        },
        "categoryTotalsMinor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current",
            "previous",
            "twoMonthsAgo"
          ],
          "properties": {
            "current": {
              "$ref": "#/$defs/minorMap"
            },
            "previous": {
              "$ref": "#/$defs/minorMap"
            },
            "twoMonthsAgo": {
              "$ref": "#/$defs/minorMap"
            }
          }
        },
        "foodSubcategoryTotalsMinor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current",
            "previous",
            "twoMonthsAgo"
          ],
          "properties": {
            "current": {
              "$ref": "#/$defs/minorMap"
            },
            "previous": {
              "$ref": "#/$defs/minorMap"
            },
            "twoMonthsAgo": {
              "$ref": "#/$defs/minorMap"
            }
          }
        },
        "merchantAmountsMinor": {
          "$ref": "#/$defs/minorMap"
        },
        "topExpenseMerchants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "merchant",
              "amountMinor"
            ],
            "properties": {
              "merchant": {
                "type": "string",
                "minLength": 1
              },
              "amountMinor": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "budgetSheetTotalsMinor": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "minProperties": 1
        },
        "vendorCategoryTotalsMinor": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "minProperties": 1
        },
        "vendorTotalsMinor": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "minProperties": 1
        },
        "topTransportExcludingFlights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "merchant",
              "amountMinor"
            ],
            "properties": {
              "merchant": {
                "type": "string"
              },
              "amountMinor": {
                "type": "integer"
              }
            }
          }
        },
        "concentratedCategories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "merchant",
              "amountMinor",
              "categoryTotalMinor",
              "sharePercent"
            ],
            "properties": {
              "category": {
                "type": "string"
              },
              "merchant": {
                "type": "string"
              },
              "amountMinor": {
                "type": "integer"
              },
              "categoryTotalMinor": {
                "type": "integer"
              },
              "sharePercent": {
                "type": "number"
              }
            }
          }
        },
        "refinementChain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topFive",
            "kept",
            "keptTotalMinor",
            "sharePercentOfMonth"
          ],
          "properties": {
            "topFive": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "merchant",
                  "amountMinor"
                ],
                "properties": {
                  "merchant": {
                    "type": "string"
                  },
                  "amountMinor": {
                    "type": "integer"
                  }
                }
              }
            },
            "kept": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "merchant",
                  "amountMinor"
                ],
                "properties": {
                  "merchant": {
                    "type": "string"
                  },
                  "amountMinor": {
                    "type": "integer"
                  }
                }
              }
            },
            "keptTotalMinor": {
              "type": "integer"
            },
            "sharePercentOfMonth": {
              "type": "number"
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tier",
        "title",
        "objective",
        "tags",
        "expectedOutcome",
        "steps",
        "assertions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(easy|medium|hard|complex)\\.[a-z0-9_]+$"
        },
        "tier": {
          "enum": [
            "easy",
            "medium",
            "hard",
            "complex"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "expectedOutcome": {
          "enum": [
            "grounded_answer",
            "clarification_then_grounded_answer",
            "calibrated_abstention",
            "cancelled_without_mutation"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "text"
                ],
                "properties": {
                  "kind": {
                    "const": "prompt"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "instruction"
                ],
                "properties": {
                  "kind": {
                    "const": "browser_action"
                  },
                  "instruction": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description",
              "weight",
              "critical"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10
              },
              "critical": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
